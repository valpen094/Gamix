<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#FFF0F5</Color> <!-- Lavender Blush -->
    <Color x:Key="Color_Foreground">#5D5D5D</Color> <!-- Soft Gray Text -->
    <Color x:Key="Color_CardBackground">#FFFFFF</Color>
    <Color x:Key="Color_ButtonForeground">#FFFFFF</Color> <!-- White -->
    
    <Color x:Key="Color_AccentPrimary">#FFD1DC</Color> <!-- Pastel Pink -->
    <Color x:Key="Color_AccentSecondary">#B2F7EF</Color> <!-- Mint -->
    <Color x:Key="Color_AccentTertiary">#E0BBE4</Color> <!-- Lavender -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <!-- 3. Accent Brushes -->
    <SolidColorBrush x:Key="Brush_AccentPrimary" Color="{StaticResource Color_AccentPrimary}"/>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- 4. Slider Brushes -->
    <SolidColorBrush x:Key="Brush_SliderBar" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_SliderThumb" Color="{StaticResource Color_AccentPrimary}"/>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#F0F0F0"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="#FFD1DC" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>

    <!-- 6. Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    </Style>

</ResourceDictionary>
