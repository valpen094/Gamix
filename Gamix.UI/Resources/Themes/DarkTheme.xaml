<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Palette -->
    <Color x:Key="Color_Background">#1E1E1E</Color> <!-- VS Dark Gray -->
    <Color x:Key="Color_Foreground">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color_CardBackground">#2D2D30</Color> <!-- Slightly Lighter Gray -->
    <Color x:Key="Color_ButtonForeground">#FFFFFF</Color> <!-- White for Buttons -->
    
    <Color x:Key="Color_AccentPrimary">#94A3B8</Color> <!-- Light Slate Gray -->
    <Color x:Key="Color_AccentSecondary">#64748B</Color> <!-- Slate Gray -->
    <Color x:Key="Color_AccentTertiary">#F87171</Color> <!-- Soft Red -->

    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <SolidColorBrush x:Key="Brush_AccentPrimary" Color="{StaticResource Color_AccentPrimary}"/>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#3F3F46"/> <!-- Gray-700 -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>

    <!-- Global Styles for this theme -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    </Style>

</ResourceDictionary>
