<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Palette -->
    <Color x:Key="Color_Background">#1E1E1E</Color> <!-- VS Dark Gray -->
    <Color x:Key="Color_Foreground">#E0E0E0</Color> <!-- Off White -->
    <Color x:Key="Color_CardBackground">#2D2D30</Color> <!-- Slightly Lighter Gray -->
    
    <Color x:Key="Color_AccentPrimary">#569CD6</Color> <!-- VS Blue -->
    <Color x:Key="Color_AccentSecondary">#4EC9B0</Color> <!-- Teal -->
    <Color x:Key="Color_AccentTertiary">#C586C0</Color> <!-- Purple -->

    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    
    <SolidColorBrush x:Key="Brush_AccentPrimary" Color="{StaticResource Color_AccentPrimary}"/>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- Global Styles for this theme -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    </Style>

</ResourceDictionary>
