<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#B3E5FC</Color> <!-- Pale Cyan/Light Blue -->
    <Color x:Key="Color_Foreground">#0277BD</Color> <!-- Deep Ocean Blue Text -->
    <Color x:Key="Color_CardBackground">#FFFFFF</Color> <!-- White -->
    <Color x:Key="Color_ButtonForeground">#FFFFFF</Color> <!-- White -->
    
    <Color x:Key="Color_AccentPrimaryStart">#29B6F6</Color> <!-- Light Blue 400 -->
    <Color x:Key="Color_AccentPrimaryEnd">#039BE5</Color> <!-- Light Blue 600 -->
    <Color x:Key="Color_AccentSecondary">#4DD0E1</Color> <!-- Cyan Accent -->
    <Color x:Key="Color_AccentTertiary">#FFFFFF</Color> <!-- Utility buttons remain white for contrast -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_Foreground}"/>
    
    <!-- 3. Accent Brushes -->
    <LinearGradientBrush x:Key="Brush_AccentPrimary" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentPrimaryEnd}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <LinearGradientBrush x:Key="Brush_AccentTertiary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF2DA" Offset="0.0"/>
        <GradientStop Color="#FFE4B5" Offset="0.5"/>
        <GradientStop Color="#FFF2DA" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 4. Slider Brushes -->
    <LinearGradientBrush x:Key="Brush_SliderBar" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentSecondary}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_SliderThumb" Color="{StaticResource Color_AccentPrimaryStart}"/>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#1A4D7A"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="Effect_GlowMagenta" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>

    <!-- 6. Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Rounded"/> <!-- Softer font for Ocean -->
    </Style>

</ResourceDictionary>
