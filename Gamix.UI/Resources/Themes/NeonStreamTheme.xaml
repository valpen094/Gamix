<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#050505</Color> <!-- Deepest Black -->
    <Color x:Key="Color_Foreground">#E0E0E0</Color> <!-- Off White -->
    <Color x:Key="Color_CardBackground">#121212</Color> <!-- Dark Gray -->
    <Color x:Key="Color_ButtonForeground">#000000</Color> <!-- Black text on neon buttons -->
    
    <Color x:Key="Color_AccentPrimaryStart">#00F0FF</Color> <!-- Cyber Cyan -->
    <Color x:Key="Color_AccentPrimaryEnd">#00A8FF</Color> <!-- Deep Cyan -->
    <Color x:Key="Color_AccentSecondary">#FF0055</Color> <!-- Neon Red/Pink -->
    <Color x:Key="Color_AccentTertiary">#FFEE00</Color> <!-- Cyber Yellow -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <!-- 3. Accent Brushes -->
    <LinearGradientBrush x:Key="Brush_AccentPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentPrimaryEnd}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- 4. Slider Brushes -->
    <LinearGradientBrush x:Key="Brush_SliderBar" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentSecondary}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_SliderThumb" Color="{StaticResource Color_AccentPrimaryStart}"/>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#222222"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="15" ShadowDepth="0" Color="{StaticResource Color_AccentPrimaryStart}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_GlowMagenta" BlurRadius="15" ShadowDepth="0" Color="{StaticResource Color_AccentSecondary}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="{StaticResource Color_AccentPrimaryStart}" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>

    <!-- 6. Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/> <!-- Monospace for Cyberpunk feel -->
    </Style>

</ResourceDictionary>
