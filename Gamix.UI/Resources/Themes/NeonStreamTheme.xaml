<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#050505</Color> <!-- Deepest Black -->
    <Color x:Key="Color_Foreground">#E0E0E0</Color> <!-- Off White -->
    <Color x:Key="Color_CardBackground">#121212</Color> <!-- Dark Gray -->
    <Color x:Key="Color_ButtonForeground">#000000</Color> <!-- Black text on neon buttons -->
    
    <Color x:Key="Color_AccentPrimaryStart">#00F0FF</Color> <!-- Cyber Cyan -->
    <Color x:Key="Color_AccentPrimaryEnd">#00A8FF</Color> <!-- Deep Cyan -->
    <Color x:Key="Color_AccentSecondary">#FF0055</Color> <!-- Neon Red/Pink -->
    <Color x:Key="Color_AccentTertiary">#FFEE00</Color> <!-- Cyber Yellow -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <!-- 3. Accent Brushes -->
    <LinearGradientBrush x:Key="Brush_AccentPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentPrimaryEnd}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- 4. Slider Brushes -->
    <LinearGradientBrush x:Key="Brush_SliderBar" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentSecondary}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_SliderThumb" Color="{StaticResource Color_AccentPrimaryStart}"/>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#222222"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="15" ShadowDepth="0" Color="{StaticResource Color_AccentPrimaryStart}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_GlowMagenta" BlurRadius="15" ShadowDepth="0" Color="{StaticResource Color_AccentSecondary}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="{StaticResource Color_AccentPrimaryStart}" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>

    <!-- 6. Global Styles -->
    <!-- NeonStream Sidebar Toggle Button Style (Flowing Stream) -->
    <Style x:Key="Style_SidebarToggleButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <!-- Background -->
                        <Ellipse Fill="#050505" Width="40" Height="40"/>
                        
                        <!-- Flowing Lines Container (Clipped to Circle) -->
                        <Grid Width="40" Height="40">
                            <Grid.Clip>
                                <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                            </Grid.Clip>
                            
                            <!-- Red Line (Top) -->
                            <Rectangle x:Name="LineRed" Height="2" Width="40" VerticalAlignment="Top" Margin="0,10,0,0" Fill="#FF0055">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Effect>
                                    <BlurEffect Radius="4"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            
                            <!-- Cyan Line (Center) -->
                            <Rectangle x:Name="LineCyan" Height="2" Width="40" VerticalAlignment="Center" Fill="#00DDFF">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Effect>
                                    <BlurEffect Radius="4"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            
                            <!-- Yellow Line (Bottom) -->
                            <Rectangle x:Name="LineYellow" Height="2" Width="40" VerticalAlignment="Bottom" Margin="0,0,0,10" Fill="#FFFF00">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Effect>
                                    <BlurEffect Radius="4"/>
                                </Rectangle.Effect>
                            </Rectangle>
                        </Grid>
                        
                        <!-- Icon Content -->
                        <ContentPresenter x:Name="IconPresenter" Content="🎵" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,-2,0,0"
                                          RenderTransformOrigin="0.5,0.5"
                                          Effect="{DynamicResource Effect_Glow}">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="IconTransform" ScaleX="1" ScaleY="1"/>
                            </ContentPresenter.RenderTransform>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="StreamAnimation">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!-- Flowing Lines (Right to Left) -->
                                        <!-- Red Line -->
                                        <DoubleAnimation Storyboard.TargetName="LineRed" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="40" To="-40" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                                        <!-- Cyan Line (Slightly delayed/faster) -->
                                        <DoubleAnimation Storyboard.TargetName="LineCyan" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="40" To="-40" Duration="0:0:1.0" RepeatBehavior="Forever" BeginTime="0:0:0.2"/>
                                        <!-- Yellow Line -->
                                        <DoubleAnimation Storyboard.TargetName="LineYellow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="40" To="-40" Duration="0:0:1.4" RepeatBehavior="Forever" BeginTime="0:0:0.1"/>

                                        <!-- Icon Bounce -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.0" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.0" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="StreamAnimation"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
