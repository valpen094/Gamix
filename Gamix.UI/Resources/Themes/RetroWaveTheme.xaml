<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#0D0221</Color> <!-- Deeper Purple for contrast -->
    <Color x:Key="Color_Foreground">#FFFAE6</Color> <!-- Cream -->
    <Color x:Key="Color_CardBackground">#1A0C2E</Color> <!-- Deep Purple Card -->
    <Color x:Key="Color_ButtonForeground">#FFFFFF</Color> <!-- White -->
    
    <Color x:Key="Color_AccentPrimaryStart">#FF2A6D</Color> <!-- Hot Pink -->
    <Color x:Key="Color_AccentPrimaryEnd">#FFDB15</Color> <!-- Sunlight Yellow/Orange glow -->
    <Color x:Key="Color_AccentSecondary">#05D9E8</Color> <!-- Cyan Blue -->
    <Color x:Key="Color_AccentTertiary">#B967FF</Color> <!-- Soft Purple Glow -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <!-- 3. Accent Brushes -->
    <LinearGradientBrush x:Key="Brush_AccentPrimary" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentPrimaryEnd}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- 4. Slider Brushes -->
    <LinearGradientBrush x:Key="Brush_SliderBar" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentSecondary}" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Use gradient for thumb too for extra retro vibe -->
    <LinearGradientBrush x:Key="Brush_SliderThumb" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="#FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#3E2A5F"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="12" ShadowDepth="0" Color="{StaticResource Color_AccentPrimaryStart}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_GlowMagenta" BlurRadius="12" ShadowDepth="0" Color="{StaticResource Color_AccentSecondary}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="{StaticResource Color_AccentTertiary}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

    <!-- 6. Global Styles -->
    <!-- RetroWave Sidebar Toggle Button Style (Synthwave Sun) -->
    <Style x:Key="Style_SidebarToggleButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Width="40" Height="40">
                        <!-- Sun Clip Geometry -->
                        <Grid.Clip>
                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                        </Grid.Clip>

                        <!-- Dark Background -->
                        <Ellipse Width="40" Height="40">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#1A0C2E" Offset="0.0"/> <!-- Deep Purple -->
                                    <GradientStop Color="#0D0221" Offset="1.0"/> <!-- Darker Purple -->
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Perspective Grid (地平線グリッド - 奥から手前へスクロール) -->
                        <Canvas Width="40" Height="40" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="GridScroll" Y="0"/>
                            </Canvas.RenderTransform>
                            
                            <!-- Grid pattern repeats to create infinite scroll (Cyan & Magenta alternating) -->
                            <!-- Line 1 (Top - Farthest) -->
                            <Rectangle Width="10" Height="0.5" Canvas.Left="15" Canvas.Top="0" Fill="#05D9E8" Opacity="0.3"/>
                            
                            <!-- Line 2 -->
                            <Rectangle Width="14" Height="0.5" Canvas.Left="13" Canvas.Top="5" Fill="#FF2A6D" Opacity="0.4"/>
                            
                            <!-- Line 3 -->
                            <Rectangle Width="18" Height="1" Canvas.Left="11" Canvas.Top="10" Fill="#05D9E8" Opacity="0.5"/>
                            
                            <!-- Line 4 -->
                            <Rectangle Width="22" Height="1" Canvas.Left="9" Canvas.Top="15" Fill="#FF2A6D" Opacity="0.6"/>
                            
                            <!-- Line 5 -->
                            <Rectangle Width="26" Height="1.5" Canvas.Left="7" Canvas.Top="20" Fill="#05D9E8" Opacity="0.7"/>
                            
                            <!-- Line 6 -->
                            <Rectangle Width="30" Height="1.5" Canvas.Left="5" Canvas.Top="25" Fill="#FF2A6D" Opacity="0.8"/>
                            
                            <!-- Line 7 -->
                            <Rectangle Width="34" Height="2" Canvas.Left="3" Canvas.Top="30" Fill="#05D9E8" Opacity="0.9"/>
                            
                            <!-- Line 8 (Bottom - Nearest) -->
                            <Rectangle Width="38" Height="2" Canvas.Left="1" Canvas.Top="35" Fill="#FF2A6D" Opacity="1.0"/>
                            
                            <!-- Second set for seamless loop (offset by pattern height) -->
                            <Rectangle Width="10" Height="0.5" Canvas.Left="15" Canvas.Top="-40" Fill="#05D9E8" Opacity="0.3"/>
                            <Rectangle Width="14" Height="0.5" Canvas.Left="13" Canvas.Top="-35" Fill="#FF2A6D" Opacity="0.4"/>
                            <Rectangle Width="18" Height="1" Canvas.Left="11" Canvas.Top="-30" Fill="#05D9E8" Opacity="0.5"/>
                            <Rectangle Width="22" Height="1" Canvas.Left="9" Canvas.Top="-25" Fill="#FF2A6D" Opacity="0.6"/>
                            <Rectangle Width="26" Height="1.5" Canvas.Left="7" Canvas.Top="-20" Fill="#05D9E8" Opacity="0.7"/>
                            <Rectangle Width="30" Height="1.5" Canvas.Left="5" Canvas.Top="-15" Fill="#FF2A6D" Opacity="0.8"/>
                            <Rectangle Width="34" Height="2" Canvas.Left="3" Canvas.Top="-10" Fill="#05D9E8" Opacity="0.9"/>
                            <Rectangle Width="38" Height="2" Canvas.Left="1" Canvas.Top="-5" Fill="#FF2A6D" Opacity="1.0"/>
                        </Canvas>
                        
                        <!-- Horizon / Glow (Bottom Edge) -->
                        <Ellipse Width="40" Height="40" StrokeThickness="2" Opacity="0.8" IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="Transparent" Offset="0.5"/>
                                    <GradientStop Color="#05D9E8" Offset="1.0"/> <!-- Cyan Glow at bottom -->
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>
                        
                        <!-- Icon Content -->
                        <ContentPresenter x:Name="IconPresenter" Content="🎵" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,-2,0,0"
                                          Panel.ZIndex="100"
                                          RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="IconTransform" ScaleX="1" ScaleY="1"/>
                            </ContentPresenter.RenderTransform>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_AccentPrimary}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SunAnimation">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!-- Grid Scrolling (一括スクロール - 奥から手前へ) -->
                                        <DoubleAnimation Storyboard.TargetName="GridScroll" 
                                                         Storyboard.TargetProperty="Y"
                                                         From="0" To="40" Duration="0:0:2" RepeatBehavior="Forever"/>
                                        
                                        <!-- Gentle Pulse -->
                                        <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.05" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="IconTransform" Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.05" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SunAnimation"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
