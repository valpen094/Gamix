<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Color Palette Definitions -->
    <Color x:Key="Color_Background">#0D0221</Color> <!-- Deeper Purple for contrast -->
    <Color x:Key="Color_Foreground">#FFFAE6</Color> <!-- Cream -->
    <Color x:Key="Color_CardBackground">#1A0C2E</Color> <!-- Deep Purple Card -->
    <Color x:Key="Color_ButtonForeground">#FFFFFF</Color> <!-- White -->
    
    <Color x:Key="Color_AccentPrimaryStart">#FF2A6D</Color> <!-- Hot Pink -->
    <Color x:Key="Color_AccentPrimaryEnd">#FFDB15</Color> <!-- Sunlight Yellow/Orange glow -->
    <Color x:Key="Color_AccentSecondary">#05D9E8</Color> <!-- Cyan Blue -->
    <Color x:Key="Color_AccentTertiary">#B967FF</Color> <!-- Soft Purple Glow -->

    <!-- 2. Base Brushes -->
    <SolidColorBrush x:Key="Brush_Background" Color="{StaticResource Color_Background}"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{StaticResource Color_Foreground}"/>
    <SolidColorBrush x:Key="Brush_CardBackground" Color="{StaticResource Color_CardBackground}"/>
    <SolidColorBrush x:Key="Brush_ButtonForeground" Color="{StaticResource Color_ButtonForeground}"/>
    
    <!-- 3. Accent Brushes -->
    <LinearGradientBrush x:Key="Brush_AccentPrimary" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentPrimaryEnd}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_AccentSecondary" Color="{StaticResource Color_AccentSecondary}"/>
    <SolidColorBrush x:Key="Brush_AccentTertiary" Color="{StaticResource Color_AccentTertiary}"/>

    <!-- 4. Slider Brushes -->
    <LinearGradientBrush x:Key="Brush_SliderBar" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource Color_AccentSecondary}" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Use gradient for thumb too for extra retro vibe -->
    <LinearGradientBrush x:Key="Brush_SliderThumb" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color_AccentPrimaryStart}" Offset="0.0"/>
        <GradientStop Color="#FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush_SliderTrackBg" Color="#3E2A5F"/>

    <!-- 5. Effects -->
    <DropShadowEffect x:Key="Effect_Glow" BlurRadius="12" ShadowDepth="0" Color="{StaticResource Color_AccentPrimaryStart}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_GlowMagenta" BlurRadius="12" ShadowDepth="0" Color="{StaticResource Color_AccentSecondary}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Effect_SidebarGlow" Color="{StaticResource Color_AccentTertiary}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

    <!-- 6. Global Styles -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush_Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Verdana"/>
    </Style>

</ResourceDictionary>
