<Window x:Class="Gamix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gamix.UI"
        xmlns:components="clr-namespace:Gamix.UI.Views.Components"
        mc:Ignorable="d"
        Title="Gamix!" Height="650" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToHeartConverter x:Key="BoolToHeartConverter"/>
    </Window.Resources>
    
    <!-- Outer Border for rounded corners and shadow -->
    <Border Background="{DynamicResource Brush_Background}" 
            CornerRadius="20" 
            Margin="0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <Grid>
             <!-- Main Content Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Device Selection -->
                    <RowDefinition Height="*"/>    <!-- Sessions -->
                </Grid.RowDefinitions>
    
                <!-- Header -->
                <components:HeaderView Grid.Row="0" SidebarRequested="HeaderView_SidebarRequested"/>

                <!-- Volume & Device Selection Section -->
                <components:DeviceControlView Grid.Row="1"/>

                <!-- Sessions List -->
                <components:SessionListView Grid.Row="2"/>
            </Grid>
            
            <!-- Sidebar Component -->
            <components:SidebarView x:Name="Sidebar"/>
        </Grid>
    </Border>
</Window>
