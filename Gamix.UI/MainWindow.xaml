<Window x:Class="Gamix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gamix.UI"
        mc:Ignorable="d"
        Title="Gamix!" Height="500" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Sidebar Animation -->
        <Storyboard x:Key="ShowSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.5" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="HideSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-250" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_AccentSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="8" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.00001*" />
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="0" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Foreground}" Margin="1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_AccentPrimary}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_AccentPrimary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter" SourceName="SidebarTrigger">
            <BeginStoryboard Storyboard="{StaticResource ShowSidebar}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Outer Border for rounded corners and shadow -->
    <Border Background="{DynamicResource Brush_Background}" 
            CornerRadius="20" 
            Margin="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#FFD1DC" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid>
             <!-- Main Content Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Device Selection -->
                    <RowDefinition Height="*"/>    <!-- Sessions -->
                </Grid.RowDefinitions>
    
                <!-- Header with Title -->
                <Grid Grid.Row="0" Margin="20,15,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                        <ColumnDefinition Width="Auto"/> <!-- Title -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Preset Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Minimize -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Icon -->
                    <TextBlock Grid.Column="0" Text="🎵" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush_AccentPrimary}"/>
                    
                    <!-- Title -->
                    <TextBlock Grid.Column="1" Text="Gamix!" 
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Brush_AccentPrimary}"
                               VerticalAlignment="Center"/>
                    
                    <!-- Preset Input -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox Width="100" Height="28" Margin="0,0,8,0" 
                                 Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalContentAlignment="Center" Padding="8,0"
                                 BorderThickness="1" BorderBrush="{DynamicResource Brush_AccentSecondary}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="💾" Command="{Binding SavePresetCommand}"
                                Width="28" Height="28"
                                Background="{DynamicResource Brush_AccentTertiary}" 
                                Foreground="{DynamicResource Brush_Foreground}" BorderThickness="0" FontSize="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    
                    <!-- Minimize Button (Right) -->
                    <Button Grid.Column="4" Content="−" Click="MinimizeButton_Click"
                            Width="28" Height="28"
                            Background="{DynamicResource Brush_AccentSecondary}" 
                            Foreground="{DynamicResource Brush_Foreground}" BorderThickness="0" FontSize="18" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Volume & Device Selection Section -->
                <Border Grid.Row="1" Background="{DynamicResource Brush_CardBackground}" 
                        CornerRadius="12" Margin="15,0,15,10" Padding="15,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Master Volume -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ボリューム" 
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,15,12"
                                   Foreground="{DynamicResource Brush_Foreground}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:F0}}" 
                                       FontSize="14" VerticalAlignment="Center" Width="30" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Brush_Foreground}"/>
                            <Slider Minimum="0" Maximum="100" Width="200"
                                    Value="{Binding MasterVolume}" 
                                    Style="{StaticResource PastelSlider}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Output Device (Speaker) -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,8">
                            <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="出力デバイス" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush_Foreground}"/>
                        </StackPanel>
                        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding OutputDevices}" 
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"
                                  FontSize="12"/>
                        
                        <!-- Input Device (Microphone) -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                            <TextBlock Text="🎤" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="入力デバイス" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush_Foreground}"/>
                        </StackPanel>
                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding InputDevices}" 
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  DisplayMemberPath="Name"
                                  FontSize="12"/>
                    </Grid>
                </Border>
    
                <!-- Sessions List -->
                <ScrollViewer Grid.Row="2" Margin="15,0,15,15" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush_CardBackground}" 
                                        CornerRadius="15" Margin="0,0,0,10" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Content -->
                                            <ColumnDefinition Width="Auto"/> <!-- Mute -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- App Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" 
                                                CornerRadius="8" Background="{DynamicResource Brush_Background}"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="24" Height="24" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ProcessName}" 
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush_Foreground}"
                                                       Margin="0,0,0,5"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Slider Grid.Column="0" Minimum="0" Maximum="1" 
                                                        Value="{Binding Volume}" 
                                                        Style="{StaticResource PastelSlider}"
                                                        VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Volume, StringFormat={}{0:P0}}" 
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush_AccentPrimary}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
    
                                        <TextBlock Grid.Column="2" Text="🔇" 
                                                   FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <!-- Dimming Overlay -->
            <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="15" CornerRadius="20"/>

            <!-- Sidebar Trigger Area (Hitbox) -->
            <Border x:Name="SidebarTrigger" Width="20" HorizontalAlignment="Left" Background="Transparent" Panel.ZIndex="10"/>

            <!-- Sidebar Panel -->
            <Border x:Name="PresetSidebar" HorizontalAlignment="Left" Width="220" 
                    Background="{DynamicResource Brush_Background}" 
                    BorderBrush="{DynamicResource Brush_AccentPrimary}" BorderThickness="0,0,2,0"
                    CornerRadius="20,0,0,20" Panel.ZIndex="20"
                    RenderTransformOrigin="0,0" Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform X="-250"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#FFD1DC" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard Storyboard="{StaticResource HideSidebar}"/>
                    </EventTrigger>
                </Border.Triggers>

                <Grid Margin="15,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Presets" FontSize="28" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush_AccentPrimary}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Apply Button -->
                                        <Button Grid.Column="0" Content="{Binding Name}" 
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,8" Margin="0,0,5,0"
                                                Background="{DynamicResource Brush_CardBackground}" 
                                                Foreground="{DynamicResource Brush_Foreground}" 
                                                BorderThickness="0" FontSize="14">
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Delete Button -->
                                        <Button Grid.Column="1" Content="🗑️" 
                                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32"
                                                Background="IndianRed"
                                                Foreground="White"
                                                BorderThickness="0" FontSize="14"
                                                ToolTip="削除 (即実行)">
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
