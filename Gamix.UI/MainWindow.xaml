<Window x:Class="Gamix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gamix.UI"
        mc:Ignorable="d"
        Title="Gamix!" Height="650" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToHeartConverter x:Key="BoolToHeartConverter"/>
        
        <!-- Sidebar Animation -->
        <Storyboard x:Key="ShowSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.5" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="HideSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-300" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_AccentSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="8" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.00001*" />
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="0" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Foreground}" Margin="1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_AccentPrimary}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_AccentPrimary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Window.Triggers for Sidebar Removed (Now Click Based) -->

    <!-- Outer Border for rounded corners and shadow -->
    <Border Background="{DynamicResource Brush_Background}" 
            CornerRadius="20" 
            Margin="0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <Grid>
             <!-- Main Content Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Device Selection -->
                    <RowDefinition Height="*"/>    <!-- Sessions -->
                </Grid.RowDefinitions>
    
                <!-- Header with Title -->
                <Grid Grid.Row="0" Margin="20,15,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                        <ColumnDefinition Width="Auto"/> <!-- Title -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Preset Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Minimize -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Icon -->
                    <!-- App Icon (Sidebar Toggle Button) -->
                    <Button Grid.Column="0" Content="🎵" FontSize="24" 
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            Foreground="{DynamicResource Brush_AccentPrimary}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="メニューを開く"
                            Click="ShowSidebar_Click">
                         <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Title -->
                    <TextBlock Grid.Column="1" Text="Gamix!" 
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Brush_AccentPrimary}"
                               VerticalAlignment="Center"/>
                    
                    <!-- Preset Input -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox Width="100" Height="28" Margin="0,0,8,0" 
                                 Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalContentAlignment="Center" Padding="8,0"
                                 BorderThickness="1" BorderBrush="{DynamicResource Brush_AccentSecondary}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="💾" Command="{Binding SavePresetCommand}"
                                Width="28" Height="28"
                                Background="{DynamicResource Brush_AccentTertiary}" 
                                Foreground="White" BorderThickness="0" FontSize="14">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    
                    <!-- Minimize Button (Right) -->
                    <Button Grid.Column="4" Content="−" Click="MinimizeButton_Click"
                            Width="28" Height="28"
                            Background="{DynamicResource Brush_AccentSecondary}" 
                            Foreground="{DynamicResource Brush_Foreground}" BorderThickness="0" FontSize="18" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Volume & Device Selection Section -->
                <StackPanel Grid.Row="1" Margin="15,0,15,10">
                    
                    <!-- Master Volume Row -->
                    <Border Background="{DynamicResource Brush_CardBackground}" 
                            CornerRadius="15" Margin="0,0,0,8" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Content -->
                                <ColumnDefinition Width="Auto"/> <!-- Percentage -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- Gradient Circle Icon - Volume (Pink to Purple) -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB6C1" Offset="0"/>
                                        <GradientStop Color="#DDA0DD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M14,8 C15.5,9.5 15.5,14.5 14,16 M16.5,5.5 C19.5,8.5 19.5,15.5 16.5,18.5" 
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                                <Slider Minimum="0" Maximum="100" 
                                        Value="{Binding MasterVolume}" 
                                        Style="{StaticResource PastelSlider}"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding MasterVolume, StringFormat={}{0:F0}%}" 
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush_AccentPrimary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       HorizontalAlignment="Right" Width="50" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                    
                    <!-- Output Device Row -->
                    <Border Background="{DynamicResource Brush_CardBackground}" 
                            CornerRadius="15" Margin="0,0,0,8" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Content -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- Gradient Circle Icon - Output (Blue to Teal) -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#87CEEB" Offset="0"/>
                                        <GradientStop Color="#48D1CC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M4,6 C4,4 6,2 9,2 L15,2 C18,2 20,4 20,6 L20,8 C20,10 18,12 15,12 L9,12 C6,12 4,10 4,8 Z M6,12 L6,20 M18,12 L18,20 M9,8 A1,1 0 1,0 9,6 A1,1 0 1,0 9,8 M15,8 A1,1 0 1,0 15,6 A1,1 0 1,0 15,8" 
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Output Device" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding OutputDevices}" 
                                          SelectedItem="{Binding SelectedOutputDevice}"
                                          DisplayMemberPath="Name" FontSize="12"
                                          Style="{StaticResource PopComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Input Device Row -->
                    <Border Background="{DynamicResource Brush_CardBackground}" 
                            CornerRadius="15" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Content -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- Gradient Circle Icon - Input (Mint to Green) -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#98FB98" Offset="0"/>
                                        <GradientStop Color="#3CB371" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M12,2 C14,2 16,4 16,7 L16,12 C16,15 14,17 12,17 C10,17 8,15 8,12 L8,7 C8,4 10,2 12,2 Z M5,11 L5,12 C5,16 8,19 12,19 C16,19 19,16 19,12 L19,11 M12,19 L12,22" 
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      Width="18" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Input Device" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding InputDevices}" 
                                          SelectedItem="{Binding SelectedInputDevice}"
                                          DisplayMemberPath="Name" FontSize="12"
                                          Style="{StaticResource PopComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </StackPanel>
    
                <!-- Sessions List -->
                <ScrollViewer Grid.Row="2" Margin="15,0,15,15" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush_CardBackground}" 
                                        CornerRadius="15" Margin="0,0,0,10" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Content -->
                                            <ColumnDefinition Width="Auto"/> <!-- Mute -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- App Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" 
                                                CornerRadius="8" Background="{DynamicResource Brush_Background}"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="24" Height="24" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ProcessName}" 
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush_Foreground}"
                                                       Margin="0,0,0,5"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Slider Grid.Column="0" Minimum="0" Maximum="1" 
                                                        Value="{Binding Volume}" 
                                                        Style="{StaticResource PastelSlider}"
                                                        VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Volume, StringFormat={}{0:P0}}" 
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush_AccentPrimary}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
    
                                        <TextBlock Grid.Column="2" Text="🔇" 
                                                   FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <!-- Dimming Overlay (Click to Close Sidebar) -->
            <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="15" CornerRadius="20"
                    MouseLeftButtonDown="HideSidebar_Click"/>

            <!-- Sidebar Trigger Area REMOVED -->

            <!-- Sidebar Panel -->
            <Border x:Name="PresetSidebar" HorizontalAlignment="Left" Width="280" 
                    Background="{DynamicResource Brush_Background}" 
                    BorderBrush="{DynamicResource Brush_AccentPrimary}" BorderThickness="0,0,2,0"
                    CornerRadius="20,0,0,20" Panel.ZIndex="20"
                    RenderTransformOrigin="0,0" Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform X="-300"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#FFD1DC" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>

                <!-- MouseLeave Trigger Removed to prevent auto-closing -->

                <Grid Margin="15,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Presets" FontSize="28" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush_AccentPrimary}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Favorite Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Name -->
                                            <ColumnDefinition Width="Auto"/> <!-- Favorite Button -->
                                            <ColumnDefinition Width="Auto"/> <!-- Rename Button -->
                                            <ColumnDefinition Width="Auto"/> <!-- Delete Button -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Favorite Icon (visible when IsFavorite) -->
                                        <TextBlock Grid.Column="0" Text="💖" FontSize="16" 
                                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"
                                                   Effect="{DynamicResource DropShadowEffect}"/>
                                        
                                        <!-- Apply Button (Name) -->
                                        <Button Grid.Column="1" Content="{Binding Name}" 
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,8" Margin="0,0,5,0"
                                                Background="{DynamicResource Brush_CardBackground}" 
                                                Foreground="{DynamicResource Brush_Foreground}" 
                                                BorderThickness="0" FontSize="14">
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Favorite Toggle Button -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32" Margin="0,0,3,0"
                                                Background="{DynamicResource Brush_AccentSecondary}"
                                                Foreground="White"
                                                BorderThickness="0" FontSize="14"
                                                ToolTip="お気に入り">
                                            <Button.Content>
                                                <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToHeartConverter}}"/>
                                            </Button.Content>
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Rename Button -->
                                        <Button Grid.Column="3" Content="✏️" 
                                                Click="RenamePreset_Click"
                                                Tag="{Binding}"
                                                Width="32" Height="32" Margin="0,0,3,0"
                                                Background="{DynamicResource Brush_AccentTertiary}"
                                                Foreground="White"
                                                BorderThickness="0" FontSize="14"
                                                ToolTip="名前変更">
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Delete Button -->
                                        <Button Grid.Column="4" Content="🗑️" 
                                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32"
                                                Background="IndianRed"
                                                Foreground="White"
                                                BorderThickness="0" FontSize="14"
                                                ToolTip="削除">
                                             <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
