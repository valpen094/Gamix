<UserControl x:Class="Gamix.UI.Views.Components.DeviceControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    
    <StackPanel Margin="15,0,15,10">
        <!-- Master Volume Row -->
        <Border Background="{DynamicResource Brush_CardBackground}" 
                CornerRadius="15" Margin="0,0,0,8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>
                
                <!-- Monitor (Output) Mute Button -->
                <Button Grid.Column="0" Command="{Binding Devices.ToggleOutputMuteCommand}" 
                        Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB6C1" Offset="0"/>
                                        <GradientStop Color="#DDA0DD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path x:Name="IconPath" 
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      Width="20" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M14,8 C15.5,9.5 15.5,14.5 14,16 M16.5,5.5 C19.5,8.5 19.5,15.5 16.5,18.5"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Devices.IsOutputMuted}" Value="True">
                                    <Setter TargetName="IconPath" Property="Data" Value="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M16,9 L21,14 M16,14 L21,9"/>
                                    <Setter TargetName="IconPath" Property="Stroke" Value="#E0E0E0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" 
                                Value="{Binding Devices.MasterVolume}" 
                                Style="{StaticResource PastelSlider}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Devices.MasterVolume, StringFormat={}{0:F0}%}" 
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush_AccentPrimary}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Width="40" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Output Device Row -->
        <Border Background="{DynamicResource Brush_CardBackground}" 
                CornerRadius="15" Margin="0,0,0,8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>
                
                <!-- Gradient Circle Icon - Output (Blue to Teal) -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#87CEEB" Offset="0"/>
                            <GradientStop Color="#48D1CC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M4,6 C4,4 6,2 9,2 L15,2 C18,2 20,4 20,6 L20,8 C20,10 18,12 15,12 L9,12 C6,12 4,10 4,8 Z M6,12 L6,20 M18,12 L18,20 M9,8 A1,1 0 1,0 9,6 A1,1 0 1,0 9,8 M15,8 A1,1 0 1,0 15,6 A1,1 0 1,0 15,8" 
                          Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                          Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Output Device" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Devices.OutputDevices}" 
                              SelectedItem="{Binding Devices.SelectedOutputDevice}"
                              DisplayMemberPath="Name" FontSize="12"
                              Style="{StaticResource PopComboBox}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Input Device Row -->
        <Border Background="{DynamicResource Brush_CardBackground}" 
                CornerRadius="15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                    <ColumnDefinition Width="*"/>    <!-- Content -->
                </Grid.ColumnDefinitions>
                
                <!-- Mic (Input) Mute Button -->
                <Button Grid.Column="0" Command="{Binding Devices.ToggleInputMuteCommand}" 
                        Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#98FB98" Offset="0"/>
                                        <GradientStop Color="#3CB371" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path x:Name="MicIconPath"
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      Width="18" Height="20" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,2 C14,2 16,4 16,7 L16,12 C16,15 14,17 12,17 C10,17 8,15 8,12 L8,7 C8,4 10,2 12,2 Z M5,11 L5,12 C5,16 8,19 12,19 C16,19 19,16 19,12 L19,11 M12,19 L12,22"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Devices.IsInputMuted}" Value="True">
                                    <Setter TargetName="MicIconPath" Property="Data" Value="M12,2 C14,2 16,4 16,7 L16,12 C16,15 14,17 12,17 C10,17 8,15 8,12 L8,7 C8,4 10,2 12,2 Z M5,11 L5,12 C5,16 8,19 12,19 C16,19 19,16 19,12 L19,11 M12,19 L12,22 M4,4 L20,20"/>
                                    <Setter TargetName="MicIconPath" Property="Stroke" Value="#E0E0E0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Input Device" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush_Foreground}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Devices.InputDevices}" 
                              SelectedItem="{Binding Devices.SelectedInputDevice}"
                              DisplayMemberPath="Name" FontSize="12"
                              Style="{StaticResource PopComboBox}"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
