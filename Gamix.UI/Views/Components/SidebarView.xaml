<UserControl x:Class="Gamix.UI.Views.Components.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gamix.UI"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToHeartConverter x:Key="BoolToHeartConverter"/>

        <Storyboard x:Key="ShowSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.5" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="HideSidebar">
            <DoubleAnimation Storyboard.TargetName="PresetSidebar" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-300" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DimOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Dimming Overlay (Click to Close Sidebar) -->
        <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="15" CornerRadius="20"
                MouseLeftButtonDown="HideSidebar_Click"/>

        <!-- Sidebar Panel -->
        <Border x:Name="PresetSidebar" HorizontalAlignment="Left" Width="280" 
                Background="{DynamicResource Brush_Background}" 
                BorderBrush="{DynamicResource Brush_AccentPrimary}" BorderThickness="0,0,2,0"
                CornerRadius="20,0,0,20" Panel.ZIndex="20"
                RenderTransformOrigin="0,0" Margin="0">
            <Border.RenderTransform>
                <TranslateTransform X="-300"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DynamicResource ResourceKey="Effect_SidebarGlow"/>
            </Border.Effect>

            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Presets" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource Brush_AccentPrimary}" Margin="0,0,0,15"
                           Effect="{DynamicResource Effect_Glow}"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Favorite Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Name -->
                                        <ColumnDefinition Width="Auto"/> <!-- Favorite Button -->
                                        <ColumnDefinition Width="Auto"/> <!-- Rename Button -->
                                        <ColumnDefinition Width="Auto"/> <!-- Delete Button -->
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Favorite Icon (visible when IsFavorite) -->
                                    <TextBlock Grid.Column="0" Text="💖" FontSize="16" 
                                               VerticalAlignment="Center" Margin="0,0,5,0"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                         <TextBlock.Effect>
                                            <DynamicResource ResourceKey="Effect_Glow"/>
                                         </TextBlock.Effect>
                                    </TextBlock>
                                    
                                    <!-- Apply Button (Name) -->
                                    <Button Grid.Column="1" Content="{Binding Name}" 
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,8" Margin="0,0,5,0"
                                            Background="{DynamicResource Brush_CardBackground}" 
                                            Foreground="{DynamicResource Brush_Foreground}" 
                                            BorderThickness="0" FontSize="14">
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    
                                    <!-- Favorite Toggle Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding DataContext.TogglePresetFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32" Margin="0,0,3,0"
                                            Background="{DynamicResource Brush_AccentSecondary}"
                                            Foreground="White"
                                            BorderThickness="0" FontSize="14"
                                            ToolTip="お気に入り">
                                        <Button.Content>
                                            <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToHeartConverter}}"/>
                                        </Button.Content>
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    
                                    <!-- Rename Button -->
                                    <Button Grid.Column="3" Content="✏️" 
                                            Click="RenamePreset_Click"
                                            Tag="{Binding}"
                                            Width="32" Height="32" Margin="0,0,3,0"
                                            Background="{DynamicResource Brush_AccentTertiary}"
                                            Foreground="White"
                                            BorderThickness="0" FontSize="14"
                                            ToolTip="名前変更">
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    
                                    <!-- Delete Button -->
                                    <Button Grid.Column="4" Content="🗑️" 
                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32"
                                            Background="IndianRed"
                                            Foreground="White"
                                            BorderThickness="0" FontSize="14"
                                            ToolTip="削除">
                                         <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
